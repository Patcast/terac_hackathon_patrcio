# Tamoa — Phase 1 configuration (docs/architecture_phase1.md §13).
# Four secrets to boot. No Stripe, no Terac, no Mongo.

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# Linq
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
LINQ_WEBHOOK_SECRET=
# LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3

# Odoo — read-only service user, see docs/tech_stack.md §5.
# The JSON-2 bearer key resolves both the database and the user, so there is
# no ODOO_DB / ODOO_USERNAME.
ODOO_URL=
ODOO_API_KEY=

# Phase 1 only
# phone -> { clientId, businessName, odooCompanyId }
CLIENT_REGISTRY_JSON={"+15550101234":{"clientId":"demo","businessName":"Northwind Studio"}}
USE_FIXTURES=false         # run the demo with no live Odoo
REPORT_CONCURRENCY=6       # parallel Odoo calls — §7
REPORT_TIMEOUT_MS=8000     # per report; a timeout is a gap, not a failure
BOOK_CACHE_ENABLED=true
SETTLING_DAYS=10           # days after month end before books count as settled — §3
TRAILING_MONTHS=12         # window for report 6; 12 gives same-month-last-year
RUNWAY_WINDOW_MONTHS=3     # months of burn averaged for runway — §5

# Web brief — docs/ui_proposal.md
# The two links the brief's call block offers. Leave blank and the buttons
# render as visibly unavailable rather than 404ing on stage.
BOOKING_URL=
PAYMENT_URL=
SESSION_PRICE=

# Server
PORT=3000
