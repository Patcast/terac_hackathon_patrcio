{
  "name": "terac",
  "version": "1.0.0",
  "description": "Fractional CFO as a service. Built for the Terac hackathon.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "tsx src/composition/server.ts",
    "brief": "USE_FIXTURES=true tsx src/composition/server.ts",
